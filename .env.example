# LLM API Keys (최소 1개 필요)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AI...

# GPT-5.5 실제 호출 검증 후 1로 바꾸면 기본 모델이 GPT-5.5가 됩니다
NAVERBLOG_GPT55_VERIFIED=0

# 검색 스킬
TAVILY_API_KEY=tvly-...

# 네이버 키워드 분석 (선택)
# 검색광고 API - 키워드 검색량/경쟁도 (https://searchad.naver.com)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 네이버 개발자 API - 트렌드/인구통계/포화지수 (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase (Streamlit Cloud 영속 DB용, 선택)
# 설정하면 SQLite 대신 Supabase PostgreSQL 사용
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...
